# Machine-local JAX/XLA settings, loaded by src/utils/precision.py on import.
# Copy to `.env` (gitignored) and uncomment/edit what you need -- every line
# here is only a default: os.environ.setdefault means a real shell-exported
# variable always takes precedence over this file.

# Force float64 on/off regardless of auto-detection (auto: on for CPU/GPU,
# off for TPU -- see precision.py's module docstring for why).
# JAX_ENABLE_X64=true

# Preallocate ~75% of GPU memory upfront instead of growing as needed
# (project default: false).
# XLA_PYTHON_CLIENT_PREALLOCATE=true

# Cap how far JAX is allowed to grow GPU memory usage -- a 0-1 FRACTION of
# the device's total memory, not an absolute byte count (JAX has no such
# env var; compute the fraction yourself, e.g. 0.5 for half of a 16GB card).
# Applies whether or not XLA_PYTHON_CLIENT_PREALLOCATE is set.
# XLA_PYTHON_CLIENT_MEM_FRACTION=0.5

# Restrict JAX to specific GPU(s) by index, e.g. "0" or "0,1" on a multi-GPU
# machine (standard CUDA env var, not JAX-specific).
# CUDA_VISIBLE_DEVICES=0
